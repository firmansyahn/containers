# Normalize all text files to LF in the repo. Scripts and records here are run
# and read on Linux hosts too — CRLF breaks shebangs and parsers there. This
# also silences the "LF will be replaced by CRLF" noise (core.autocrlf=true).
* text=auto eol=lf

# Force LF on files executed/parsed on Linux, regardless of auto detection.
*.sh        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.csv       text eol=lf
*.md        text eol=lf
*.log       text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf

# Windows scripts keep CRLF.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binaries — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.ico       binary
*.xlsx      binary
*.gz        binary
*.zip       binary
